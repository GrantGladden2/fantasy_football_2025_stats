          <datasource-dependencies datasource='federated.0ywt3t71bkaor515a1xs113bc2ko'>
            <column caption='Pass Yards per Game' datatype='real' name='[Calculation_0957438522699783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([pass_yd_pts]*25)/[games]' />
            </column>
            <column caption='QB Stats' datatype='real' name='[Calculation_2041281859358725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2041281858002944]&#13;&#10;    WHEN &apos;points&apos;&#13;&#10;    THEN [points]&#13;&#10;    WHEN &apos;pass_yd_pts&apos;&#13;&#10;    THEN [pass_yd_pts]&#13;&#10;    WHEN &apos;pass_td_pts&apos;&#13;&#10;    THEN [pass_td_pts]&#13;&#10;    WHEN &apos;rush_yd_pts&apos;&#13;&#10;    THEN [rush_yd_pts]&#13;&#10;    WHEN &apos;rush_td_pts&apos;&#13;&#10;    THEN [rush_td_pts]&#13;&#10;    WHEN &apos;interceptions&apos;&#13;&#10;    THEN [interceptions]&#13;&#10;    WHEN &apos;fumbles&apos;&#13;&#10;    THEN [fumbles]&#13;&#10;END' />
            </column>
            <column caption='Rush Yards per Game ' datatype='real' name='[Yard Points per Game (copy)_0957438538989583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([rush_yd_pts]*10)/[games]' />
            </column>
