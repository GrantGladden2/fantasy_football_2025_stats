      <aliases enabled='yes' />
      <column caption='Fantasy Points per Game' datatype='real' name='[Calculation_0957438522617862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[points]/[games]' />
      </column>
      <column caption='Pass Yards per Game' datatype='real' name='[Calculation_0957438522699783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([pass_yd_pts]*25)/[games]' />
      </column>
      <column caption='Touchdowns per Game' datatype='real' name='[Calculation_0957438522867720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([pass_td_pts]/6)/[games]' />
      </column>
      <column caption='Interceptions per Game' datatype='real' name='[Calculation_0957438522916873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[interceptions]/[games]' />
      </column>
      <column caption='Top Player' datatype='string' name='[Calculation_0957438527393805]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF [Calculation_2041281859358725] = { FIXED : MAX([Calculation_2041281859358725]) } &#13;&#10;    THEN [player] END &#13;&#10;) }' />
      </column>
      <column caption='Turnovers per Game' datatype='real' name='[Calculation_0957438553985040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([fumbles]+[interceptions])/[games]' />
      </column>
      <column caption='Turnovers' datatype='real' name='[Calculation_0957438565281812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([fumbles]+[interceptions])*2' />
      </column>
      <column caption='QB Stats' datatype='real' name='[Calculation_2041281859358725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2041281858002944]&#13;&#10;    WHEN &apos;points&apos;&#13;&#10;    THEN [points]&#13;&#10;    WHEN &apos;pass_yd_pts&apos;&#13;&#10;    THEN [pass_yd_pts]&#13;&#10;    WHEN &apos;pass_td_pts&apos;&#13;&#10;    THEN [pass_td_pts]&#13;&#10;    WHEN &apos;rush_yd_pts&apos;&#13;&#10;    THEN [rush_yd_pts]&#13;&#10;    WHEN &apos;rush_td_pts&apos;&#13;&#10;    THEN [rush_td_pts]&#13;&#10;    WHEN &apos;interceptions&apos;&#13;&#10;    THEN [interceptions]&#13;&#10;    WHEN &apos;fumbles&apos;&#13;&#10;    THEN [fumbles]&#13;&#10;END' />
      </column>
      <column caption='Total Points' datatype='real' name='[Calculation_2041281868734477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pass_td_pts]+[pass_yd_pts]+[rush_td_pts]+[rush_yd_pts]-[Calculation_0957438565281812]' />
      </column>
      <column caption='Rush Yards per Game ' datatype='real' name='[Yard Points per Game (copy)_0957438538989583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([rush_yd_pts]*10)/[games]' />
      </column>
